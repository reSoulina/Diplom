@page
@model WebDesignerSystem.Pages.Admin.Appointments.IndexModel
@{
    ViewData["Title"] = "Записи на услуги";
}

<div class="container">
    <div class="catalog-header-section">
        <div class="title-wrapper">
            <h1 class="mb-0">Записи на услуги</h1>
        </div>
    </div>

    <div class="admin-table-container">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Клиент</th>
                    <th>Услуга</th>
                    <th>Дата и время</th>
                    <th>Формат</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var app in Model.Appointments)
                {
                    <tr>
                        <td>@app.Client.FullName</td>
                        <td>@app.Service.Name</td>
                        <td>@app.AppointmentDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(app.Format == "online" ? "Онлайн" : "Офлайн")</td>
                        <td>
                            <span class="admin-badge" style="background-color:
                                    @(app.Status == "pending" ? "#f59e0b" : app.Status == "confirmed" ? "#10b981" : app.Status == "completed" ? "#3b82f6" : "#ef4444");">
                                @(app.Status == "pending" ? "Ожидает" : app.Status == "confirmed" ? "Подтверждена" : app.Status == "completed" ? "Выполнена" : "Отменена")
                            </span>
                        </td>
                        <td>
                            <a asp-page="./Details" asp-route-id="@app.Id" class="admin-action-btn">Детали</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>