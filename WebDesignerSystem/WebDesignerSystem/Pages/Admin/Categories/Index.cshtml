@page
@attribute [Authorize(Roles = "Designer")]
@using Microsoft.AspNetCore.Authorization
@model WebDesignerSystem.Pages.Admin.Categories.IndexModel

@{
    ViewData["Title"] = "Категории";
}

<div class="container">
    <!-- Заголовок на фиолетовом фоне -->
    <div class="admin-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="title-wrapper">
                <h1 class="mb-2">Категории</h1>
            </div>
            <a asp-page="Create" class="btn btn-success" style="background: #10b981; border: none;">
                <i class="bi bi-plus-circle me-2"></i> Добавить категорию
            </a>
        </div>
    </div>

    @if (Model.Categories.Any())
    {
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Название</th>
                        <th>Описание</th>
                        <th style="width: 120px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td>
                                <strong>@category.Name</strong>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(category.Description))
                                {
                                    <span>@category.Description</span>
                                }
                                else
                                {
                                    <span style="color: rgba(255,255,255,0.5);">—</span>
                                }
                            </td>
                            <td>
                                <a asp-page="Edit" asp-route-id="@category.Id" class="admin-action-btn" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@category.Id" class="admin-action-btn danger" title="Удалить">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Статистика -->
        <div class="row mt-4">
            <div class="col-md-4 mx-auto">
                <div class="admin-stat-card">
                    <h3>@Model.Categories.Count()</h3>
                    <p>Всего категорий</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="admin-empty-state">
            <i class="bi bi-tags"></i>
            <h3>Категории не найдены</h3>
            <p>Добавьте первую категорию для товаров и услуг</p>
            <a asp-page="Create" class="btn-primary" style="background: white; color: var(--primary); padding: 0.6rem 1.5rem; border-radius: 30px; text-decoration: none;">
                <i class="bi bi-plus-circle me-2"></i>Добавить категорию
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const deleteButtons = document.querySelectorAll('a[href*="Delete"]');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    if (!confirm('Вы уверены, что хотите удалить эту категорию?\nТовары этой категории не будут удалены.')) {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>
}