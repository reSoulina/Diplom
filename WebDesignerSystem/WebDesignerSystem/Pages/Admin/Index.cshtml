@page
@attribute [Authorize(Roles = "Designer")]
@using Microsoft.AspNetCore.Authorization
@model WebDesignerSystem.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Панель управления";
}

<div class="container">
    <!-- Заголовок -->
    <div class="text-center mb-4">
        <div class="admin-title-wrapper d-inline-block">
            <h1 class="mb-0">Панель управления</h1>
        </div>
    </div>

    <!-- Управление каталогом - прямоугольные карточки -->
    <div class="row justify-content-center">
        <div class="col-md-4">
            <div class="admin-rect-card">
                <div class="admin-rect-icon">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div class="admin-rect-content">
                    <h4 class="admin-rect-title">Товары и услуги</h4>
                    <a asp-page="/Admin/Products/Index" class="admin-rect-btn">
                        Управление <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="admin-rect-card">
                <div class="admin-rect-icon">
                    <i class="bi bi-tags"></i>
                </div>
                <div class="admin-rect-content">
                    <h4 class="admin-rect-title">Категории</h4>
                    <a asp-page="/Admin/Categories/Index" class="admin-rect-btn">
                        Управление <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Профиль дизайнера -->
    @if (Model.DesignerProfile != null)
    {
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="designer-profile-card">
                    <div class="row align-items-center">
                        <div class="col-md-3 text-center">
                            <img src="@(Model.DesignerProfile.PhotoUrl ?? "/images/profile_photo.jpg")" 
                                 alt="@Model.DesignerProfile.Name"
                                 class="designer-profile-avatar"
                                 onerror="this.onerror=null; this.src='/images/profile_photo.jpg';">
                        </div>
                        <div class="col-md-9">
                            <h2 class="designer-profile-name">@Model.DesignerProfile.Name</h2>
                            <p class="designer-profile-position">@Model.DesignerProfile.Position</p>
                            <p class="designer-profile-bio">@Model.DesignerProfile.Bio</p>
                            <div class="designer-profile-contacts">
                                <div class="contact-chip">
                                    <i class="bi bi-envelope"></i>
                                    <span>@Model.DesignerProfile.Email</span>
                                </div>
                                <div class="contact-chip">
                                    <i class="bi bi-phone"></i>
                                    <span>@Model.DesignerProfile.Phone</span>
                                </div>
                                <div class="contact-chip">
                                    <i class="bi bi-clock"></i>
                                    <span>@Model.DesignerProfile.WorkingHours</span>
                                </div>
                            </div>
                            <div class="mt-3">
                                <a asp-page="/Admin/Profile/Index" class="btn-edit-profile">
                                    <i class="bi bi-pencil me-2"></i>Редактировать профиль
                                </a>
                                <a asp-page="/Account/ChangePassword/Index" class="btn-change-password">
                                    <i class="bi bi-key me-2"></i>Сменить пароль
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
