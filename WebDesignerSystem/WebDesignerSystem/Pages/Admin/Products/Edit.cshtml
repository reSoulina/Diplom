@page "{id:int}"
@attribute [Authorize(Roles = "Designer")]
@using Microsoft.AspNetCore.Authorization
@model WebDesignerSystem.Pages.Admin.Products.EditModel

@{
    ViewData["Title"] = "Редактировать товар/услугу";
}

<div class="container">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="admin-form-container">
                <h1>@ViewData["Title"]</h1>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.2); border: none; color: white;">
                        @TempData["SuccessMessage"]
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger" style="background: rgba(239, 68, 68, 0.2); border: none; color: white;">
                        @TempData["ErrorMessage"]
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Product.Id" />
                    <input type="hidden" asp-for="Product.ExistingImageUrl" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Product.Name" class="form-control" placeholder=" " />
                                <label asp-for="Product.Name"></label>
                                <span asp-validation-for="Product.Name" class="text-danger" style="color: #ff9e9e !important;"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <input asp-for="Product.Price" class="form-control" type="number" step="0.01" placeholder=" " />
                                <label asp-for="Product.Price"></label>
                                <span asp-validation-for="Product.Price" class="text-danger" style="color: #ff9e9e !important;"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="Product.ProductType" class="form-select">
                                    <option value="product">Товар</option>
                                    <option value="service">Услуга</option>
                                </select>
                                <label asp-for="Product.ProductType"></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                <select asp-for="Product.CategoryId" asp-items="Model.Product.Categories" class="form-select">
                                    <option value="">Выберите категорию</option>
                                </select>
                                <label asp-for="Product.CategoryId"></label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label"></label>
                        <textarea asp-for="Product.Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Product.Description" class="text-danger" style="color: #ff9e9e !important;"></span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Product.ExistingImageUrl))
                    {
                        <div class="mb-3">
                            <label class="form-label">Текущее изображение</label>
                            <div>
                                <img src="@Model.Product.ExistingImageUrl" 
                                     alt="Текущее изображение" 
                                     class="img-thumbnail"
                                     style="max-width: 300px; max-height: 300px; background: rgba(255,255,255,0.9);" />
                                <div class="form-text mt-2" style="color: rgba(255,255,255,0.7);">
                                    Чтобы изменить изображение, загрузите новый файл ниже.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="mb-4">
                        <label asp-for="Product.ImageFile" class="form-label">Новое изображение</label>
                        <input asp-for="Product.ImageFile" class="form-control file-input-preview"
                               type="file" accept="image/*"
                               data-preview-container="imagePreview"
                               data-preview-image="previewImage" />
                        <div class="form-text" style="color: rgba(255,255,255,0.7);">
                            Оставьте поле пустым, чтобы сохранить текущее изображение.
                        </div>
                        
                        <div id="imagePreview" class="mt-2" style="display: none;">
                            <p class="text-muted" style="color: rgba(255,255,255,0.7) !important;">Предпросмотр нового изображения:</p>
                            <img id="previewImage" class="img-thumbnail" style="max-width: 200px; max-height: 200px; background: rgba(255,255,255,0.9);" />
                        </div>
                    </div>

                    <div class="form-check mb-4">
                        <input asp-for="Product.IsActive" class="form-check-input" />
                        <label asp-for="Product.IsActive" class="form-check-label"></label>
                        <div class="form-text" style="color: rgba(255,255,255,0.7);">
                            Если отключено, товар не будет отображаться в каталоге для клиентов.
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <div>
                            <a asp-page="Index" class="btn btn-secondary me-2">
                                <i class="bi bi-arrow-left"></i> Назад к списку
                            </a>
                        </div>
                        <div>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> Сохранить изменения
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}