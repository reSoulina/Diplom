@page
@attribute [Authorize(Roles = "Designer")]
@using Microsoft.AspNetCore.Authorization
@model WebDesignerSystem.Pages.Admin.Products.IndexModel

@{
    ViewData["Title"] = "Товары и услуги";
}

<div class="container">
    <!-- Заголовок на фиолетовом фоне -->
    <div class="admin-header">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div class="title-wrapper">
                <h1 class="mb-2">Товары и услуги</h1>
            </div>
            <a asp-page="Create" class="btn btn-success" style="background: #10b981; border: none;">
                <i class="bi bi-plus-circle me-2"></i> Добавить
            </a>
        </div>
    </div>

    <!-- Фильтры -->
    <div class="admin-form-container mb-4">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <label class="form-label">Категория</label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                    <option value="">Все категории</option>
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">Тип</label>
                <select asp-for="ProductType" class="form-select">
                    <option value="">Все</option>
                    <option value="product">Товары</option>
                    <option value="service">Услуги</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Применить</button>
            </div>
        </form>
    </div>

    @if (Model.Products.Any())
    {
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 70px;">Фото</th>
                        <th>Название</th>
                        <th>Категория</th>
                        <th>Тип</th>
                        <th>Цена</th>
                        <th>Статус</th>
                        <th style="width: 100px;">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td class="align-middle">
                                @if (!string.IsNullOrEmpty(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" class="admin-table-img" />
                                }
                                else
                                {
                                    <div class="admin-table-img d-flex align-items-center justify-content-center bg-light" style="background: rgba(255,255,255,0.1) !important;">
                                        <i class="bi @(product.IsService ? "bi-calendar-check" : "bi-box-seam")" style="color: rgba(255,255,255,0.5); font-size: 1.5rem;"></i>
                                    </div>
                                }
                            </td>
                            <td class="align-middle">
                                <strong>@product.Name</strong>
                                @if (!string.IsNullOrEmpty(product.Description))
                                {
                                    <br>
                                    <small style="color: rgba(255,255,255,0.6);">@(product.Description.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</small>
                                }
                            </td>
                            <td class="align-middle">
                                @if (product.Category != null)
                                {
                                    <span class="admin-badge admin-badge-secondary">@product.Category.Name</span>
                                }
                                else
                                {
                                    <span style="color: rgba(255,255,255,0.5);">—</span>
                                }
                            </td>
                            <td class="align-middle">
                                <span class="admin-badge @(product.IsService ? "admin-badge-info" : "admin-badge-success")">
                                    @(product.IsService ? "Услуга" : "Товар")
                                </span>
                            </td>
                            <td class="align-middle">
                                <strong>@product.Price.ToString("C")</strong>
                            </td>
                            <td class="align-middle">
                                @if (product.IsActive)
                                {
                                    <span class="admin-badge admin-badge-success">Активно</span>
                                }
                                else
                                {
                                    <span class="admin-badge admin-badge-danger">Неактивно</span>
                                }
                            </td>
                            <td class="align-middle">
                                <a asp-page="Edit" asp-route-id="@product.Id" class="admin-action-btn" title="Редактировать">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="Delete" asp-route-id="@product.Id" class="admin-action-btn danger" title="Удалить">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Статистика -->
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="admin-stat-card">
                    <h3>@Model.Products.Count()</h3>
                    <p>Всего</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="admin-stat-card">
                    <h3>@Model.Products.Count(p => !p.IsService)</h3>
                    <p>Товаров</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="admin-stat-card">
                    <h3>@Model.Products.Count(p => p.IsService)</h3>
                    <p>Услуг</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="admin-stat-card">
                    <h3>@Model.Products.Count(p => p.IsActive)</h3>
                    <p>Активных</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="admin-empty-state">
            <i class="bi bi-box"></i>
            <h3>Товары не найдены</h3>
            <p>Добавьте первый товар или измените параметры фильтрации</p>
            <a asp-page="Create" class="btn-primary" style="background: white; color: var(--primary); padding: 0.6rem 1.5rem; border-radius: 30px; text-decoration: none;">
                <i class="bi bi-plus-circle me-2"></i>Добавить товар
            </a>
        </div>
    }
</div>