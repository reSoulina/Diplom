@page
@attribute [Authorize(Roles = "Client")]
@using Microsoft.AspNetCore.Authorization
@model WebDesignerSystem.Pages.Client.Profile.IndexModel
@{
    ViewData["Title"] = "Мой профиль";
}

<div class="container">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="admin-form-container">
                <h1 class="form-title">
                    <i class="bi bi-person-circle me-2"></i>@ViewData["Title"]
                </h1>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success" style="background: rgba(16, 185, 129, 0.2); border: none; color: white;">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    </div>
                }

                <form method="post">
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>
                    
                    <input type="hidden" asp-for="Profile.Id" />
                    <input type="hidden" asp-for="Profile.UserId" />
                    
                    <div class="mb-3">
                        <label asp-for="Profile.FullName" class="form-label">
                            <i class="bi bi-person me-1"></i>Полное имя *
                        </label>
                        <input asp-for="Profile.FullName" class="form-control" />
                        <span asp-validation-for="Profile.FullName" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Profile.Phone" class="form-label">
                            <i class="bi bi-telephone me-1"></i>Телефон
                        </label>
                        <input asp-for="Profile.Phone" class="form-control" placeholder="+7 (999) 123-45-67" />
                        <span asp-validation-for="Profile.Phone" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="Profile.DeliveryAddress" class="form-label">
                            <i class="bi bi-geo-alt me-1"></i>Адрес доставки
                        </label>
                        <textarea asp-for="Profile.DeliveryAddress" class="form-control" rows="3" placeholder="Город, улица, дом, квартира"></textarea>
                        <span asp-validation-for="Profile.DeliveryAddress" class="text-danger"></span>
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">
                            <i class="bi bi-envelope me-1"></i>Email
                        </label>
                        <input class="form-control" value="@User.Identity?.Name" disabled />
                        <div class="form-text">Email нельзя изменить</div>
                    </div>
                    
                    <div class="d-flex justify-content-between mt-4">
                        <a asp-page="/Client/Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Назад
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Сохранить изменения
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}