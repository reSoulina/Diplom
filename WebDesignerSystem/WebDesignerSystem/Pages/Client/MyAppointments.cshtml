@page
@model WebDesignerSystem.Pages.Client.MyAppointmentsModel
@{
    ViewData["Title"] = "Мои записи на услуги";
}

<div class="container">
    <div class="title-wrapper">
        <h1 class="mb-0">Мои записи</h1>
    </div>

    @if (Model.Appointments.Any())
    {
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Услуга</th>
                        <th>Дата и время</th>
                        <th>Формат</th>
                        <th>Контакт / Адрес</th>
                        <th>Статус</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var app in Model.Appointments)
                    {
                        <tr>
                            <td>@app.Service.Name</td>
                            <td>@app.AppointmentDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(app.Format == "online" ? "Онлайн" : "Офлайн")</td>
                            <td>
                                @if (app.Format == "online")
                                {
                                    @(string.IsNullOrEmpty(app.ContactInfo) ? "—" : app.ContactInfo)
                                }
                                else
                                {
                                    @(string.IsNullOrEmpty(app.Address) ? "—" : app.Address)
                                }
                            </td>
                            <td>
                                <span class="admin-badge" style="background-color:
                                            @(app.Status == "pending" ? "#f59e0b" : app.Status == "confirmed" ? "#10b981" : app.Status == "completed" ? "#3b82f6" : "#ef4444");
                                            color: white;">
                                    @(app.Status == "pending" ? "Ожидает" : app.Status == "confirmed" ? "Подтверждена" : app.Status == "completed" ? "Выполнена" : "Отменена")
                                </span>
                            </td>
                            <td>
                                @if (app.Status == "pending")
                                {
                                    <form method="post" asp-page-handler="Cancel" asp-route-id="@app.Id" style="display:inline">
                                        <button type="submit" class="admin-action-btn danger" onclick="return confirm('Отменить запись?')">Отменить</button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="admin-empty-state">
            <i class="bi bi-calendar-x"></i>
            <h3>У вас пока нет записей</h3>
            <a href="/Catalog/Index" class="btn-primary">Перейти в каталог</a>
        </div>
    }
</div>