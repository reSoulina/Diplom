@page "{id:int}"
@model WebDesignerSystem.Pages.Client.BookServiceModel
@{
    ViewData["Title"] = "Запись на услугу";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="admin-form-container">
                <h1 class="form-title">Запись на услугу</h1>
                <h3 class="mb-3 text-white">@Model.Service.Name</h3>
                <p>@Model.Service.Description</p>
                <p><strong>Цена:</strong> @Model.Service.Price.ToString("C")</p>
                <hr />

                @if (!ViewData.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                }

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="Service.Id" />

                    <div class="mb-3">
                        <label class="form-label">Дата *</label>
                        <input type="date" id="appointmentDate" asp-for="Input.AppointmentDate" class="form-control" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                        <span asp-validation-for="Input.AppointmentDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Время *</label>
                        <select id="appointmentTime" asp-for="Input.AppointmentTime" class="form-select" required>
                            @if (Model.AvailableTimeSlots.Any())
                            {
                                foreach (var slot in Model.AvailableTimeSlots)
                                {
                                    <option value="@slot.Time">@slot.DisplayText</option>
                                }
                            }
                            else
                            {
                                <option value="">Нет доступного времени</option>
                            }
                        </select>
                        <span asp-validation-for="Input.AppointmentTime" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Формат *</label>
                        <select asp-for="Input.Format" class="form-select" id="formatSelect" required>
                            <option value="">-- Выберите формат --</option>
                            <option value="online">Онлайн (консультация, связь по телефону)</option>
                            <option value="offline">Офлайн (встреча в Уфе)</option>
                        </select>
                        <span asp-validation-for="Input.Format" class="text-danger"></span>
                    </div>

                    <div id="onlineFields" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label">Контактный телефон (для онлайн)</label>
                            <input asp-for="Input.ContactInfo" class="form-control" />
                            <span class="form-text text-white">Можно изменить, если нужно</span>
                            <span asp-validation-for="Input.ContactInfo" class="text-danger"></span>
                        </div>
                    </div>

                    <div id="offlineFields" style="display: none;">
                        <div class="mb-3">
                            <label class="form-label">Адрес (для офлайн)</label>
                            <input asp-for="Input.Address" class="form-control" />
                            <span class="form-text text-white">Можно изменить</span>
                            <span asp-validation-for="Input.Address" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Примечания</label>
                        <textarea asp-for="Input.Notes" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-page="/Catalog/Index" class="btn btn-secondary">Отмена</a>
                        <button type="submit" class="btn btn-primary">Записаться</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Управление видимостью полей онлайн/офлайн
        const formatSelect = document.getElementById('formatSelect');
        const onlineFields = document.getElementById('onlineFields');
        const offlineFields = document.getElementById('offlineFields');

        function toggleFormatFields() {
            if (formatSelect.value === 'online') {
                if (onlineFields) onlineFields.style.display = 'block';
                if (offlineFields) offlineFields.style.display = 'none';
            } else if (formatSelect.value === 'offline') {
                if (onlineFields) onlineFields.style.display = 'none';
                if (offlineFields) offlineFields.style.display = 'block';
            } else {
                if (onlineFields) onlineFields.style.display = 'none';
                if (offlineFields) offlineFields.style.display = 'none';
            }
        }
        formatSelect.addEventListener('change', toggleFormatFields);
        toggleFormatFields();

        // Динамическая загрузка доступных слотов времени
        const dateInput = document.getElementById('appointmentDate');
        const timeSelect = document.getElementById('appointmentTime');
        const serviceId = @Model.Service.Id;

        async function loadTimeSlots(date) {
            if (!date) return;
            // Правильный URL для вызова обработчика TimeSlots
            const url = `/Client/BookService/${serviceId}?handler=TimeSlots&date=${encodeURIComponent(date)}`;
            try {
                const response = await fetch(url);
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                const slots = await response.json();
                timeSelect.innerHTML = '';
                if (slots.length === 0) {
                    const option = document.createElement('option');
                    option.value = '';
                    option.textContent = 'Нет доступного времени';
                    timeSelect.appendChild(option);
                } else {
                    slots.forEach(slot => {
                        const option = document.createElement('option');
                        option.value = slot.value;
                        option.textContent = slot.text;
                        timeSelect.appendChild(option);
                    });
                }
            } catch (error) {
                console.error('Ошибка загрузки слотов:', error);
                timeSelect.innerHTML = '<option value="">Ошибка загрузки времени</option>';
            }
        }

        dateInput.addEventListener('change', function() {
            loadTimeSlots(this.value);
        });

        // Загружаем слоты для текущей даты при загрузке страницы
        if (dateInput.value) {
            loadTimeSlots(dateInput.value);
        }
    </script>
}