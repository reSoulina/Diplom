@page
@model WebDesignerSystem.Pages.IndexModel
@{
    ViewData["Title"] = "Информационная система веб-дизайнера";
}

@if (Model.DesignerProfile != null)
{
    <!-- Герой секция -->
    <section class="hero-section-new">
        <div class="container">
            <div class="hero-content">
                <h1>МЕГА КРУТОЙ<br>ДИЗАЙНЕР</h1>
                <div class="hero-divider"></div>
                <p class="hero-description">
                    Творец, кастомщик и создатель неповторимых дизайнов.<br>
                    Превращаю ваши идеи в реальность.
                </p>
                <div class="hero-buttons">
                    <button class="btn-hero-primary" onclick="location.href='/Catalog/Index'">
                        <i class="bi bi-grid me-2"></i>Смотреть работы
                    </button>
                    <a href="#services" class="btn-hero-secondary">
                        <i class="bi bi-arrow-down me-2"></i>Узнать больше
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- КАРТОЧКА ДИЗАЙНЕРА С ФОТО СЛЕВА -->
    <div class="d-flex justify-content-center">
        <div class="designer-card-horizontal">
            <div class="designer-card-container">
                <div class="designer-photo-side">
                    <img src="@(Model.DesignerProfile.PhotoUrl ?? "/images/profile_photo.jpg")" 
                         alt="@Model.DesignerProfile.Name"
                         onerror="this.onerror=null; this.src='/images/profile_photo.jpg';">
                </div>
                
                <div class="designer-info-side">
                    <div class="about-title">О ДИЗАЙНЕРЕ</div>
                    <h2 class="designer-name">@Model.DesignerProfile.Name</h2>
                    <p class="designer-position">@Model.DesignerProfile.Position</p>
                    <p class="designer-bio">
                        @Model.DesignerProfile.Bio
                    </p>
                    
                    <div class="designer-contacts">
                        <div class="contact-item-simple">
                            <i class="bi bi-envelope"></i>
                            <span>@Model.DesignerProfile.Email</span>
                        </div>
                        <div class="contact-item-simple">
                            <i class="bi bi-phone"></i>
                            <span>@Model.DesignerProfile.Phone</span>
                        </div>
                        <div class="contact-item-simple">
                            <i class="bi bi-clock"></i>
                            <span>@Model.DesignerProfile.WorkingHours</span>
                        </div>
                    </div>                
                </div>
            </div>
        </div>
    </div>
}

<!-- Блок УСЛУГИ -->
<section id="services" class="services-section">
    <div class="container">
        <div class="services-grid">
            <div class="service-item">
                <div class="service-icon">
                    <i class="bi bi-palette"></i>
                </div>
                <h4>Веб-дизайн</h4>
                <p>Создание уникального дизайна под ваш бренд</p>
                <button class="btn-service" onclick="location.href='/Catalog/Index'">ПОДРОБНЕЕ</button>
            </div>
            <div class="service-item">
                <div class="service-icon">
                    <i class="bi bi-code-slash"></i>
                </div>
                <h4>Мерч</h4>
                <p>Товары с оригинальным дизайном</p>
                <button class="btn-service" onclick="location.href='/Catalog/Index'">ПОДРОБНЕЕ</button>
            </div>
            <div class="service-item">
                <div class="service-icon">
                    <i class="bi bi-chat-dots"></i>
                </div>
                <h4>Консультации</h4>
                <p>Профессиональные консультации по проекту</p>
                <button class="btn-service" onclick="location.href='/Catalog/Index'">ПОДРОБНЕЕ</button>
            </div>
        </div>
    </div>
</section>