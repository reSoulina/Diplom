@page
@model LogoutModel

@{
    ViewData["Title"] = "Выход";
}

<div class="logout-container">
    <div class="auth-card" style="max-width: 500px; margin: 0 auto;">
        <h2>@ViewData["Title"]</h2>
        <hr />
        <p>Вы успешно вышли из системы.</p>
        <a asp-page="/Index" class="btn btn-primary">На главную</a>
    </div>
</div>