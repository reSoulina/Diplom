<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebDesignerSystem</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">
                <img src="/images/logo.png" alt="ProLabb" style="height: 40px; width: auto; margin-right: 0.5rem">ProLabb
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Index" ? "active" : "")"
                           asp-page="/Index">Главная</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Catalog/Index" ? "active" : "")"
                           asp-page="/Catalog/Index">Каталог</a>
                    </li>

                    @if (User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("Designer"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i>Админ
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-page="/Admin/Index">Панель управления</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Profile/Index">Мой профиль</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Products/Index">Товары и услуги</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Categories/Index">Категории</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Orders/Index">Заказы клиентов</a></li>
                                    <li><a class="dropdown-item" asp-page="/Admin/Appointments/Index">Записи на услуги</a></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole("Client"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="adminDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear me-1"></i>Кабинет
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-page="/Client/Index">Мой профиль</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-page="/Client/MyOrders">Мои заказы</a></li>
                                    <li><a class="dropdown-item" asp-page="/Client/MyAppointments">Мои записи</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark @(ViewContext.RouteData.Values["Page"]?.ToString() == "/Client/Cart/Index" ? "active" : "")"
                                   asp-page="/Client/Cart/Index">
                                    <i class="bi bi-cart me-1"></i>Корзина
                                </a>
                            </li>
                        }
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-muted">
                                <i class="bi bi-person me-1"></i>@User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-page="/Account/Logout" method="post">
                                <button type="submit" class="nav-link btn btn-link text-dark">
                                    <i class="bi bi-box-arrow-right me-1"></i>Выйти
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i>Войти
                            </a>
                        </li>
                        <li class="nav-item ms-2">
                            <a class="btn btn-primary" asp-page="/Account/Register">Регистрация</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="mt-5">
        <div class="container">
            <div class="row justify-content-between">
                <div class="col-md-4 mb-4 mb-md-0">
                    <a class="navbar-brand d-flex align-items-center" asp-page="/Index">
                        <img src="/images/logo.png" alt="ProLabb" style="height: 40px; width: auto; margin-right: 0.75rem">
                        <span style="font-size: 1.5rem; font-weight: 700;">ProLabb</span>
                    </a>
                    <p class="text-light mb-0 mt-3" style="opacity: 0.8; font-size: 0.9rem;">Дизайнер, которого вы искали</p>
                </div>

                <div class="col-md-4 mb-4 mb-md-0 text-center">
                    <h5 class="text-white mb-3" style="font-size: 1.1rem; font-weight: 600;">Навигация</h5>
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <a asp-page="/Index" class="text-light text-decoration-none" style="opacity: 0.8; transition: all 0.2s ease; font-size: 0.9rem;">
                                Главная
                            </a>
                        </li>
                        <li class="mb-2">
                            <a asp-page="/Catalog/Index" class="text-light text-decoration-none" style="opacity: 0.8; transition: all 0.2s ease; font-size: 0.9rem;">
                                Каталог
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="col-md-4 mb-4 mb-md-0 text-md-end">
                    <ul class="list-unstyled">
                        <li class="mb-2 d-flex justify-content-md-end align-items-center gap-2">
                            <span class="text-light" style="opacity: 0.8; font-size: 0.9rem;">Пн-Пт: 9:00 - 18:00</span>
                        </li>
                        <li class="mb-2 d-flex justify-content-md-end align-items-center gap-2">
                            <a href="mailto:designer@gmail.com" class="text-light text-decoration-none" style="opacity: 0.8; transition: all 0.2s ease; font-size: 0.9rem;">
                                designer@gmail.com
                            </a>
                        </li>
                        <li class="mb-2 d-flex justify-content-md-end align-items-center gap-2">
                            <a href="tel:+79991234567" class="text-light text-decoration-none" style="opacity: 0.8; transition: all 0.2s ease; font-size: 0.9rem;">
                                +7 (999) 123-45-67
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>